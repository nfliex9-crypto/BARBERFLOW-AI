# For production set unique long random secret and run behind HTTPS
APP_ENV=development
SECRET_KEY=replace-with-unique-random-string-in-production
BF_OUTPUT_WIDTH=1080
BF_OUTPUT_HEIGHT=1920
BF_MAX_UPLOAD_MB=250
BF_MAX_INPUT_MINUTES=45
BF_DATA_DIR=./media
BF_MAX_SALON_STORAGE_MB=5000
BF_MAX_ACTIVE_PER_SALON=3
BF_WORKERS=2
# Production disables open registration by default; temporarily set true to onboard a pilot salon.
BF_ALLOW_OPEN_SIGNUP=false
# Requires persistent storage in production; note Railway Free is not suitable for heavy rendering.

# Optional: durable SMTP notifications require a separate worker and an authorized TLS mail provider.
BF_SMTP_ENABLED=false
BF_SMTP_HOST=
BF_SMTP_PORT=587
BF_SMTP_SECURITY=starttls
BF_SMTP_FROM=
BF_SMTP_USER=
BF_SMTP_PASSWORD=
